{
  "name": "template-io",
  "version": "0.0.1",
  "author": "JP Wogaman II",
  "repository": {
    "type": "git",
    "url": "https://github.com/wogamusic/template.io"
  },
  "description": "Workflow enhancement for Open Stage Control, VEP, & Cubase.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "next lint",
    "start": "next start",
    "deps": "ncu --interactive --format group",
    "depsProd": "ncu --interactive --dep prod --format group",
    "tauri": "tauri",
    "count": "count-lines-in-repo.bat",
    "full_clean": "cd src-tauri && cargo clean && cd.. && rm -rf node_modules/ && rm -rf pnpm-lock.yaml && rm -rf dist/ && rm -rf .next/ && pnpm install && pnpm tauri dev",
    "migrations": "cd src-tauri && ENV DATABASE_URL=\"file:./migrations.sqlite\" diesel migration run && rm -rf ./migrations.sqlite"
  },
  "ct3aMetadata": {
    "initVersion": "6.11.2"
  },
  "engines": {
    "node": "22",
    "pnpm": "10"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^15.5.9",
    "@next/env": "^15.5.9",
    "@react-icons/all-files": "^4.1.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tauri-apps/api": "~2",
    "@tauri-apps/plugin-clipboard-manager": "~2",
    "@tauri-apps/plugin-dialog": "~2.3",
    "@tauri-apps/plugin-fs": "~2.4",
    "@tauri-apps/plugin-global-shortcut": "~2",
    "@tauri-apps/plugin-http": "~2",
    "@tauri-apps/plugin-notification": "~2",
    "@tauri-apps/plugin-os": "~2",
    "@tauri-apps/plugin-process": "~2",
    "@tauri-apps/plugin-shell": "~2",
    "@tauri-apps/plugin-updater": "~2",
    "@use-gesture/react": "^10.3.1",
    "motion": "^12.38.0",
    "next": "15.5.9",
    "next-themes": "^0.4.6",
    "react": "19.2.5",
    "react-color": "^2.19.3",
    "react-colorful": "^5.6.1",
    "react-dom": "19.2.5",
    "react-icons": "^5.6.0",
    "reactcss": "^1.2.3",
    "server-only": "^0.0.1",
    "superjson": "2.2.6",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.2.4",
    "@tauri-apps/cli": "^2.10.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.2.3",
    "@types/reactcss": "^1.2.13",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "babel-plugin-react-compiler": "19.1.0-rc.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "15.5.9",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "postcss": "^8.5.12",
    "prettier": "^3.8.3",
    "prettier-plugin-rust": "^0.1.9",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3"
  }
}